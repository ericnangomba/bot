# Copy to /etc/botteam.env with owner root and mode 0600 for systemd.
# BOTTEAM_TOKEN=replace-with-at-least-24-random-characters
# TELEGRAM_BOT_TOKEN=
# ALLOWED_USER_IDS=123456789
# TELEGRAM_FORUM_CHAT_IDS=-1001234567890
# TELEGRAM_BOT_TOPICS='{"-1001234567890":{"builder":37,"reviewer":41}}'
# TELEGRAM_VOICE_PER_HOUR=8
# TELEGRAM_VOICE_MAX_SECONDS=180
# TELEGRAM_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# BRAVE_SEARCH_API_KEY=
# BOTTEAM_GITHUB_TOKEN=

# Optional private browser workbench at /ui/; disabled without this password.
# Use a dedicated vault-generated password with at least 24 characters, not BOTTEAM_TOKEN.
# BOTTEAM_WEB_PASSWORD=
# Only for an authenticated TLS reverse proxy; exact HTTPS origin, no path.
# Leave unset for an SSH tunnel to http://127.0.0.1:8042/ui/ .
# BOTTEAM_WEB_ORIGIN=https://botteam.example.com
# Explicitly link new dashboard jobs to this allowlisted owner's PRIVATE Telegram chat.
# Set only after the owner has started the bot in Telegram. No guessed recipient IDs.
# BOTTEAM_TELEGRAM_OWNER_ID=123456789
